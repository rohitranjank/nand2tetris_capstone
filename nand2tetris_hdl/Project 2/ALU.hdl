CHIP ALU {
    IN x[16],y[16],zx,nx,zy,ny,f,no;
    OUT out[16],zr,ng;
    PARTS:
        Mux16(a=x,b[0..15]=false,sel=zx,out=x1);
        Not16(in=x1,out=nx1);
        Mux16(a=x1,b=nx1,sel=nx,out=x2);
        Mux16(a=y,b[0..15]=false,sel=zy,out=y1);
        Not16(in=y1,out=ny1);
        Mux16(a=y1,b=ny1,sel=ny,out=y2);
        And16(a=x2,b=y2,out=andout);
        Add16(a=x2,b=y2,out=addout);
        Mux16(a=andout,b=addout,sel=f,out=out1);
        Not16(in=out1,out=notout);
        Mux16(a=out1,b=notout,sel=no,out=out);
        Or8Way(in=out[0..7],out=zr1);
        Or8Way(in=out[8..15],out=zr2);
        Or(a=zr1,b=zr2,out=any);
        Not(in=any,out=zr);
}
