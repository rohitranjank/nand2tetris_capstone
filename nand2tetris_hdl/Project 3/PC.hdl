CHIP PC {
    IN in[16],load,inc,reset;
    OUT out[16];
    PARTS:
        Inc16(in=out,out=incout);
        Mux16(a=out,b=incout,sel=inc,out=step);
        Mux16(a=step,b=in,sel=load,out=loadout);
        Mux16(a=loadout,b[0..15]=false,sel=reset,out=next);
        Register(in=next,load=true,out=out);
}
